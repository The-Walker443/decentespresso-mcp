 {
  "id": "profile:7438cb7266f60558b48f",
  "profile": {
   "version": "2",
   "title": "Blooming Espresso",
   "notes": "This technique causes a furor when Rao first published it.  His extraction of 24% is 2% higher than what is usually attainable with only the very best grinders, yet Rao did it with an inexpensive home grinder.  This technique is especially appropriate for lightly roasted, complex and expensive coffee beans.  If you have a bluetooth scale, you can keep track of how much dripping into the cup there is before the ramp stage.  8 grams of total dripping, within 2 grams, seems to give the best tasting results. Try adusting your grind and dose to get that amount of dripping, and see if you like how it tastes.",
   "author": "Decent",
   "beverage_type": "espresso",
   "steps": [
    {
     "name": "preinfusion start",
     "pump": "flow",
     "transition": "fast",
     "exit": null,
     "volume": 500.0,
     "seconds": 2.0,
     "weight": 0.0,
     "temperature": 97.5,
     "sensor": "coffee",
     "flow": 4.0,
     "limiter": {
      "value": 0.0,
      "range": 0.6
     }
    },
    {
     "name": "preinfusion",
     "pump": "flow",
     "transition": "fast",
     "exit": {
      "type": "pressure",
      "condition": "over",
      "value": 4.0
     },
     "volume": 500.0,
     "seconds": 23.0,
     "weight": 0.0,
     "temperature": 97.5,
     "sensor": "coffee",
     "flow": 4.0,
     "limiter": null
    },
    {
     "name": "pause",
     "pump": "flow",
     "transition": "fast",
     "exit": null,
     "volume": 500.0,
     "seconds": 30.0,
     "weight": 0.0,
     "temperature": 90.0,
     "sensor": "coffee",
     "flow": 0.0,
     "limiter": null
    },
    {
     "name": "ramp",
     "pump": "flow",
     "transition": "smooth",
     "exit": null,
     "volume": 500.0,
     "seconds": 5.0,
     "weight": 0.0,
     "temperature": 92.0,
     "sensor": "coffee",
     "flow": 2.2,
     "limiter": null
    },
    {
     "name": "flat flow",
     "pump": "flow",
     "transition": "fast",
     "exit": null,
     "volume": 500.0,
     "seconds": 20.0,
     "weight": 0.0,
     "temperature": 92.0,
     "sensor": "coffee",
     "flow": 2.2,
     "limiter": {
      "value": 8.6,
      "range": 0.6
     }
    },
    {
     "name": "reset temperature",
     "pump": "flow",
     "transition": "fast",
     "exit": null,
     "volume": 500.0,
     "seconds": 1.0,
     "weight": 0.0,
     "temperature": 98.0,
     "sensor": "coffee",
     "flow": 0.0,
