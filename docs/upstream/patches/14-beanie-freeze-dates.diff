+// Decaid's freezeDate/unfreezeDate describe one period: the latest freeze and,
+// if it has ended, the thaw after it. Kept in step with the events so a client
+// that only knows Decaid's fields sees the same freezer state as Beanie.
+export function decaidFreezeFields(
+  events: readonly BeanBatchStorageEvent[]
+): Pick<BeanBatch, 'freezeDate' | 'unfreezeDate'> {
+  let freezeDate: string | null = null;
+  let unfreezeDate: string | null = null;
+  for (const event of events) {
+    if (event.type === 'frozen') {
+      freezeDate = event.at;
+      unfreezeDate = null;
+    } else if (freezeDate) {
+      unfreezeDate = event.at;
+    }
+  }
+  return { freezeDate, unfreezeDate };
+}
