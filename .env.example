# Kopieren nach .env und ausfuellen. .env gehoert NICHT ins Git (SPEC ss10.3).

# Visualizer-Zugang (HTTP Basic Auth, SPEC ss4). Seit M8 nicht mehr die
# Quelle des Archivs - die Angaben bleiben nur, weil der Upload nach
# visualizer.coffee als Community-Schaufenster weiterlaufen kann.
VISUALIZER_EMAIL=you@example.com
VISUALIZER_PASSWORD=change-me

# Ersetzt die Authentifizierung des MCP-Endpoints (SPEC ss10.1).
# Mindestens 32 Zeichen, nur [A-Za-z0-9_-]. Erzeugen mit:
#   openssl rand -hex 24
MCP_PATH_SECRET=<openssl rand -hex 24>

# Quelle ab M8 (SPEC 20): Decaid auf dem Tablet, reines LAN.
# Nur private IP-Literale werden akzeptiert - ein Hostname koennte spaeter
# woandershin zeigen, und dieser Verkehr darf das LAN nicht verlassen.
DECAID_URL=http://10.100.100.171:8080

# Waechter-Benachrichtigung (SPEC 20.7). Leer lassen = keine Nachrichten;
# die Waechter laufen trotzdem, ihre Befunde stehen in audit_archive.
# NTFY_URL ohne NTFY_TOPIC ist ein Konfigurationsfehler.
# Gemeldet werden nur Bezuege der letzten 48 h, hoechstens eine Nachricht je
# Bezug und hoechstens 5 je Lauf - sonst liest man die erste und keine weitere.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# Welche Waechterregeln laufen (SPEC 20.7). Ohne Angabe alle vier; "none"
# schaltet sie ganz ab. Einzeln abschaltbar, weil eine Regel, die zu oft
# anschlaegt, sonst im Ganzen ignoriert wird und die anderen mitnimmt.
#   grind_not_adjusted  Charge gewechselt, Mahlgrad blieb stehen
#   bean_age            Bohne beim Bezug ueber der Altersschwelle
#   missing_rating      Bewertung nicht nachgetragen
#   dose_outlier        Gewichte passen nicht zum Soll des Workflows
GUARD_RULES=

# Schwellen der Waechter. Die Vorgaben stammen aus dem echten Bestand.
BEAN_AGE_WARN_DAYS=42
RATING_GRACE_HOURS=36
DOSE_TOLERANCE_G=1.0

# Sync (M1+); 0..1440 Minuten, 0 schaltet die Hintergrundschleife ab
SYNC_INTERVAL_MIN=15

# Schreibende Tools (SPEC 18, 20.5). Aus heisst: die Tools existieren nicht -
# sie tauchen gar nicht erst in der Tool-Liste auf. Nur einschalten, wenn
# Claude in Decaid aendern koennen soll: update_shot, update_bean,
# update_batch, set_workflow.
WRITE_ENABLED=false

DB_PATH=/data/shots.db
LOG_LEVEL=INFO
TZ=Europe/Berlin

# Nur fuer die Ausgabe der Connector-URL via --print-connector-url
PUBLIC_BASE_URL=https://coffee-mcp.example.com

# Bind-Adresse im Container; am Host wird kein Port veroeffentlicht.
HOST=0.0.0.0
PORT=8000
