# Copy to .env and fill in. .env does NOT belong in git (SPEC §10.3).

# Visualizer account (HTTP Basic Auth, SPEC §4). No longer the source of the
# archive since M8 - these settings only remain because the upload to
# visualizer.coffee can carry on as a community showcase.
VISUALIZER_EMAIL=you@example.com
VISUALIZER_PASSWORD=change-me

# Stands in for authentication of the MCP endpoint (SPEC §10.1).
# At least 32 characters, only [A-Za-z0-9_-]. Generate with:
#   openssl rand -hex 24
MCP_PATH_SECRET=<openssl rand -hex 24>

# The source from M8 on (SPEC §20): Decaid on the tablet, local network only.
# Only private IP literals are accepted - a hostname could later be repointed
# somewhere else, and this traffic must not leave the local network.
DECAID_URL=http://10.100.100.171:8080

# Guard notifications (SPEC §20.7). Leave empty for no messages; the guards
# still run and their findings remain available through audit_archive.
# NTFY_URL without NTFY_TOPIC is a configuration error.
# Only shots from the last 48 h are reported, at most one message per shot and
# at most 5 per run - otherwise one reads the first and none after it.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# Which guard rules run (SPEC §20.7). Without a setting all four; "none"
# switches them off entirely. Each can be disabled on its own, because a rule
# that fires too often gets ignored wholesale and takes the others with it.
#   grind_not_adjusted  batch changed, grind setting stayed put
#   bean_age            bean past the age threshold when pulled
#   missing_rating      rating never added
#   dose_outlier        weights do not match the workflow target
GUARD_RULES=

# Thresholds of the guards. The defaults come from the real archive.
BEAN_AGE_WARN_DAYS=42
RATING_GRACE_HOURS=36
DOSE_TOLERANCE_G=1.0

# Sync (M1+); 0..1440 minutes, 0 switches the background loop off
SYNC_INTERVAL_MIN=15

# Write tools (SPEC §18, §20.5). Off means the tools do not exist - they do not
# even appear in the tool list. Only switch this on if Claude should be able to
# change things in Decaid: update_shot, update_bean, update_batch, set_workflow.
WRITE_ENABLED=false

DB_PATH=/data/shots.db
LOG_LEVEL=INFO
TZ=Europe/Berlin

# Only for printing the connector URL via --print-connector-url
PUBLIC_BASE_URL=https://coffee-mcp.example.com

# Bind address inside the container; no port is published on the host.
HOST=0.0.0.0
PORT=8000
